# Copy this file to .env and replace the local values before starting the backend.
DB_URL=jdbc:mysql://localhost:3306/kurukshetra?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-demo-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
